# Copy to .env and adjust as needed
PORT=4000
DATABASE_URL=postgres://stayly:stayly@localhost:5432/stayly
CORS_ORIGIN=*
SEED_ON_BOOT=true
MIGRATIONS_ON_BOOT=true

# Admin panel — password fallback
ADMIN_PASSWORD=stayly-admin

# Admin panel — Clerk emails allowed to manage listings (comma-separated)
ALLOWED_ADMIN_EMAILS=

# Clerk — authentication (login/signup). Publishable key from dashboard.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional secret key (used to resolve user emails server-side)
CLERK_SECRET_KEY=

# Cloudinary image storage (get these from console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=